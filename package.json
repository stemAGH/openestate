{
  "name": "openestate",
  "private": true,
  "version": "0.9.1",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test test:serial",
    "typecheck": "turbo run typecheck",
    "seed": "pnpm --filter @openestate/db run seed",
    "seed:demo": "pnpm --filter @openestate/db run seed:demo",
    "seed:portal-demo": "pnpm --filter @openestate/api run seed:portal-demo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
